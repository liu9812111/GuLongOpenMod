<Project Sdk="Microsoft.NET.Sdk">
  <!--
    编译：dotnet build -c Release
    第一次编译前，把同目录的 GameDir.props.example 复制成 GameDir.props，改成你自己的游戏目录。
    （也可以直接 dotnet build -c Release -p:GameDir="D:\Steam\steamapps\common\古龙风云录"）
    编译成功后会自动：
      - 把插件复制到  游戏目录\BepInEx\plugins\GuLongOpenMod\
      - 把仓库 packs\ 下的内容包复制到  游戏目录\Mod\Packs\   （不想复制就加 -p:CopyPacks=false）
  -->
  <Import Project="GameDir.props" Condition="Exists('GameDir.props')" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GuLongOpenMod</AssemblyName>
    <RootNamespace>GuLongOpenMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <CopyPacks Condition="'$(CopyPacks)' == ''">true</CopyPacks>
    <PacksDir>$(MSBuildThisFileDirectory)..\packs</PacksDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\GuLong_Data\Managed\*.dll"
               Exclude="$(GameDir)\GuLong_Data\Managed\mscorlib.dll;$(GameDir)\GuLong_Data\Managed\System*.dll;$(GameDir)\GuLong_Data\Managed\netstandard.dll;$(GameDir)\GuLong_Data\Managed\Mono.*.dll;$(GameDir)\GuLong_Data\Managed\Microsoft.*.dll"
               Private="false" />
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GameDir)' == ''"
           Text="没有设置游戏目录。把 plugin\GameDir.props.example 复制成 GameDir.props 并填好游戏目录，或者编译时加 -p:GameDir=游戏目录" />
    <Error Condition="'$(GameDir)' != '' And !Exists('$(GameDir)\GuLong_Data\Managed\Assembly-CSharp.dll')"
           Text="游戏目录不对：$(GameDir) 下找不到 GuLong_Data\Managed\Assembly-CSharp.dll" />
    <Error Condition="'$(GameDir)' != '' And !Exists('$(GameDir)\BepInEx\core\BepInEx.dll')"
           Text="游戏目录里还没装 BepInEx 5（找不到 BepInEx\core\BepInEx.dll），请先按 docs\安装.md 安装" />
  </Target>

  <Target Name="CopyToGame" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\GuLongOpenMod" />
    <ItemGroup>
      <PackFiles Include="$(PacksDir)\**\*" Exclude="$(PacksDir)\**\README.md" />
    </ItemGroup>
    <Copy Condition="'$(CopyPacks)' == 'true'" SourceFiles="@(PackFiles)"
          DestinationFiles="@(PackFiles->'$(GameDir)\Mod\Packs\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="插件已复制到 $(GameDir)\BepInEx\plugins\GuLongOpenMod" />
    <Message Condition="'$(CopyPacks)' == 'true'" Importance="high" Text="内容包已复制到 $(GameDir)\Mod\Packs" />
  </Target>
</Project>
