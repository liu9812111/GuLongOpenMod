// 亢龙有悔（招式 xk_s0002）的演出：xk_yinlong（推掌 + 借来的龙，染成金色）
//   文件名 = 新演出名，SkillItem 表里 xk_s0002 的 AnimationName 就是 xk_yinlong
//   原版 gl_skill_empty_107（推掌）不受影响
//   想把龙放到别的动作上：把 "base" 换成那个动作编号（F6 预览里找），其余不用动
//   改完保存，游戏里按 F7 立即生效（F6 预览开着会自动重播）
{
  "base": "gl_skill_empty_107",

  "add": [
    {
      "from": "gl_skill_both_014",          // 龙出自 银枪穿云（原版是银色的）
      "fx": "VFX_Dragon_dash_attack",
      "time": 0.0,                          // 出现时间（秒），对照 F6 预览里底子动作的命中时间调
      "speed": 1.15,                        // 播放速度（原招 1.15；调小 = 龙飞得慢）
      "scale": 1.3,                         // 大小倍率：1 = 原大小
      "move": [0, 0, 0],                    // 位置偏移（米）：[左右, 上下, 前后]，正数 = 右/上/前
      "rotate": [0, 0, 0],                  // 再转多少度：[俯仰, 左右转, 翻滚]
      // ── 换颜色 ──
      // 龙由龙身/龙须/龙舌三块组成，每块两层材质：
      //   _Color    = 龙身本体的颜色（Standard 材质）
      //   _RimColor = 外面那层玻璃质感的边缘光（银色感主要来自这里）
      // props 直接指定颜色（不是乘法），3 个数 = [红,绿,蓝]，龙的淡入淡出透明度会保留
      //   金龙  "_Color": [1, 0.75, 0.25],  "_RimColor": [1, 0.7, 0.15]
      //   赤龙  "_Color": [0.9, 0.2, 0.15], "_RimColor": [1, 0.3, 0.1]
      //   青龙  "_Color": [0.2, 0.8, 0.7],  "_RimColor": [0.3, 1, 0.9]
      //   黑龙  "_Color": [0.1, 0.1, 0.12], "_RimColor": [0.5, 0.2, 0.8]
      // 数值属性写一个数，如 "_Metallic": [1]（金属感）、"_Glossiness": [0.8]（光滑度）—— 日志里会列出有哪些、原来是多少
      "props": {
        "_Color": [1, 0.75, 0.25],
        "_RimColor": [1, 0.7, 0.15]
      },
      "color": [1, 1, 1],                   // 整体再乘一个颜色（粒子类特效用这个），1 1 1 = 不变
      "hue": 0,                             // 色相旋转（度），给彩色特效换色用
      "brightness": 1                       // 亮度倍率，1.5 = 更亮，0.6 = 更暗
    }
  ],

  // edit：调整底子动作（这里是推掌 107）里本来就有的特效，可用的参数和上面一样（不用写 from）
  //   特效名在 F6 预览里看【攻击方】列出来的；同名的有好几个时用 index 指定第几个（从 0 数）
  //   例：[ { "fx": "某特效", "index": 0, "time": 0.5, "scale": 0.5, "color": [1, 0.8, 0.3] } ]
  "edit": [],

  // remove：删掉底子动作里本来就有的特效（同名的全删），例：[ "某特效", "另一个特效" ]
  "remove": []
}
